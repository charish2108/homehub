{
  "name": "homehub",
  "version": "0.1.0",
  "private": true,
  "description": "Local hub that unifies mixed-brand Wi-Fi appliances behind one API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build",
    "test:integration": "node scripts/verify-hub.mjs"
  },
  "dependencies": {
    "@kud/androidtv-remote": "^0.1.2",
    "mqtt": "^5.10.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
