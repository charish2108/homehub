{
  "name": "homehub-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-platform desktop client for the local HomeHub smart-home hub",
  "author": "Re:imagine",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check settings.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.reimagine.homehub",
    "productName": "HomeHub",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "settings.js",
      "index.html",
      "settings.html",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
